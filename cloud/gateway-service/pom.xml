<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.allen</groupId>
        <artifactId>question-bank-cloud</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>gateway-service</artifactId>
    <name>gateway-service</name>
    <description>Spring Cloud Gateway（8080）：路由 + 统一鉴权 + Redis 限流</description>

    <dependencies>
        <!-- 复用统一错误契约 ErrorBody，网关 401/503 与下游服务返回同一种形状 -->
        <dependency>
            <groupId>com.allen</groupId>
            <artifactId>cloud-common</artifactId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>
        <!-- 响应式网关；注意不能同时引入 spring-boot-starter-web，否则会退化成 Servlet 栈启动失败 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>
        <!-- Redis 限流需要 reactive 版 Redis 驱动 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
        </dependency>
        <!-- /actuator/health 是证据脚本的就绪探针，缺它 404 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- 链路追踪：micrometer API 经 OTel bridge 落到 OpenTelemetry SDK，span 以 OTLP/HTTP 导出
             （接收端 = otelcol-contrib 0.160.0，4318/v1/traces，debug exporter 打印全部 span）。
             版本由 Boot 3.4 BOM 管理，采样率与端点在 application.yml 的 management.tracing / management.otlp 节 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
